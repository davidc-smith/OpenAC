<panel x="640" y="60" w="300" h="176" title="Controls: Dialogs" theme="plugin">
  <button x="10" y="28" w="135" h="22" text="OK / Cancel" onclick="{AskDefault}" />
  <button x="155" y="28" w="135" h="22" text="Three buttons" onclick="{AskThree}" />
  <button x="10" y="56" w="135" h="22" text="Four buttons" onclick="{AskFour}" />
  <button x="155" y="56" w="135" h="22" text="No owner" onclick="{AskUnowned}" />
  <button x="10" y="84" w="135" h="22" text="Queue two" onclick="{AskTwo}" />
  <button x="155" y="84" w="135" h="22" text="Edit profile..." onclick="{EditProfile}"
          tooltip="Right-click for more">
    <contextmenu items="Edit profile...|Reset profile" onselect="{ProfileMenu}" />
  </button>
  <separator x="10" y="116" w="280" h="1" />
  <label x="10" y="126" text="Profile" color="theme:muted|#FF9AA99E" />
  <label x="70" y="126" text="{ProfileSummary}" />
  <label x="10" y="150" text="{Status}" />
</panel>
