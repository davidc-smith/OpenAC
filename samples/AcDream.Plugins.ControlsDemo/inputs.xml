<panel x="56" y="40" w="300" h="336" title="Controls: Inputs" theme="plugin">
  <label x="10" y="28" text="Pick up" color="theme:muted|#FF9AA99E" />
  <checkbox x="10" y="46" w="200" h="16" text="Everything below" checked="{AllPickups}" onchange="{SetAllPickups}" />
  <checkbox x="28" y="66" w="180" h="16" text="Rares" checked="{Rares}" onchange="{SetRares}" />
  <checkbox x="28" y="86" w="180" h="16" text="Scrolls" checked="{Scrolls}" onchange="{SetScrolls}" />
  <checkbox x="28" y="106" w="180" h="16" text="Salvage" checked="{Salvage}" onchange="{SetSalvage}" />
  <checkbox x="210" y="46" w="80" h="16" text="Pyreals" checked="{Pyreals}" enabled="false" />
  <label x="212" y="64" text="display only" color="theme:muted|#FF9AA99E" />
  <separator x="10" y="130" w="280" h="1" />
  <label x="10" y="140" text="Heal at %" />
  <number x="110" y="138" w="80" h="20" value="{HealAt}" min="0" max="100" step="5" onchange="{SetHealAt}" />
  <label x="10" y="166" text="Range (m)" />
  <number x="110" y="164" w="80" h="20" value="{Range}" min="0.5" max="60" step="0.5" decimals="1" onchange="{SetRange}" />
  <separator x="10" y="194" w="280" h="1" />
  <radio x="10" y="204" w="120" h="54" items="Melee|Missile|Magic" selected="{Mode}" onchange="{SetMode}" />
  <separator x="140" y="204" w="1" h="54" color="theme:border|#FF61573B" />
  <label x="150" y="222" text="{ModeHint}" color="theme:muted|#FF9AA99E" />
  <radio x="10" y="268" w="280" h="20" items="{Speeds}" selected="{Speed}" onchange="{SetSpeed}"
         orientation="horizontal" style="segmented" />
  <separator x="10" y="298" w="280" h="1" />
  <label x="10" y="308" text="{Status}" />
</panel>
