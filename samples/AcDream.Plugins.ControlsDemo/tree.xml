<panel x="920" y="290" w="380" h="314" title="Controls: Tree" theme="plugin" resizable="true" minw="300" minh="200">
  <list name="rules" x="10" y="28" w="360" h="250" tree="true" levels="{Levels}" keys="{Keys}" header="true"
        selected="{Selected}" onchange="{Select}" onexpand="{Expanded}" anchor="left top right bottom">
    <column type="checkbox" width="22" values="{On}" onchange="{Toggle}" />
    <column type="text" header="Rule" width="200" items="{Names}" sort="text" />
    <column type="text" header="Value" items="{Values}" />
    <contextmenu items="Enable branch|Disable branch" onopen="{MenuOpened}" onselect="{MenuPicked}" />
  </list>
  <label x="10" y="290" text="{Status}" anchor="left bottom" />
</panel>
