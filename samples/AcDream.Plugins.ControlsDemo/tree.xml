<panel x="916" y="226" w="354" h="340" title="Controls: Tree" theme="plugin" resizable="true" minw="300" minh="200">
  <label x="10" y="31" text="Note" />
  <field x="50" y="28" w="120" h="20" text="{Note}" onchange="{SetNote}" />
  <label x="178" y="31" text="Click here, then Tab to the list" color="theme:muted|#FF9AA99E" />
  <list name="rules" x="10" y="54" w="334" h="250" tree="true" selectionband="true" levels="{Levels}" keys="{Keys}" header="true"
        selected="{Selected}" onchange="{Select}" onexpand="{Expanded}" anchor="left top right bottom">
    <column type="checkbox" width="22" values="{On}" onchange="{Toggle}" />
    <column type="text" header="Rule" width="200" items="{Names}" sort="text" />
    <column type="text" header="Value" items="{Values}" />
    <contextmenu items="Enable branch|Disable branch" enabled="{MenuEnabled}" onopen="{MenuOpened}" onselect="{MenuPicked}" />
  </list>
  <label x="10" y="316" text="{Status}" anchor="left bottom" />
</panel>
