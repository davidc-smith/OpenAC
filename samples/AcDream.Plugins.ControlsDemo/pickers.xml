<panel x="366" y="40" w="300" h="200" title="Controls: Keys and colours" theme="plugin">
  <label x="10" y="30" text="Toggle radar" />
  <hotkey x="130" y="28" w="160" h="20" value="{RadarKey}" onchange="{SetRadarKey}" />
  <label x="10" y="56" text="Pause macro" />
  <hotkey x="130" y="54" w="160" h="20" value="{PauseKey}" onchange="{SetPauseKey}" />
  <separator x="10" y="102" w="280" h="1" />
  <label x="10" y="114" text="Bar colour" />
  <color x="130" y="112" w="40" h="18" value="{BarColor}" onchange="{SetBarColor}" alpha="true" />
  <group x="180" y="112" w="110" h="18" background="{BarColor}" border="theme:border|#FF61573B" />
  <label x="10" y="140" text="Heading colour" />
  <color x="130" y="138" w="40" h="18" value="{HeadingColor}" onchange="{SetHeadingColor}" />
  <label x="180" y="140" text="Sample heading" color="{HeadingColor}" />
  <separator x="10" y="166" w="280" h="1" />
  <label x="10" y="176" text="{Status}" />
</panel>
