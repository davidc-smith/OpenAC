<panel x="20" y="410" w="420" h="282" title="Controls: Layout" theme="plugin" resizable="true" minw="360" minh="240">
  <split name="main" x="10" y="28" w="400" h="244" at="140" min="80" max="260" onchange="{SplitMoved}"
         anchor="left top right bottom">
    <group>
      <list x="0" y="0" w="140" h="244" anchor="left top right bottom" items="{Sections}"
            selected="{Section}" onchange="{SetSection}" selectionband="true" />
    </group>
    <group>
      <expander name="general" x="6" y="0" w="243" h="62" text="General" onchange="{GeneralChanged}"
                anchor="left top right">
        <checkbox x="4" y="4" w="200" h="16" text="Show names" checked="{ShowNames}" onchange="{SetShowNames}" />
        <checkbox x="4" y="24" w="200" h="16" text="Show distances" checked="{ShowDistances}" onchange="{SetShowDistances}" />
      </expander>
      <expander x="6" y="66" w="243" h="108" text="Advanced (bound)" expanded="{AdvancedOpen}"
                onchange="{SetAdvancedOpen}" anchor="left top right">
        <label x="4" y="6" text="Scan (m)" />
        <number x="90" y="4" w="70" h="20" value="{Scan}" min="1" max="200" onchange="{SetScan}" />
        <expander name="more" x="0" y="30" w="239" h="56" text="More" open="false">
          <checkbox x="4" y="4" w="200" h="16" text="Verbose log" checked="{Verbose}" onchange="{SetVerbose}" />
        </expander>
      </expander>
      <label x="6" y="180" text="{Status}" />
    </group>
  </split>
</panel>
