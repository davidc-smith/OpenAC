<panel x="986" y="20" w="284" h="198" title="Controls: Repeat" theme="plugin" layout="column" padding="8" gap="6"
       resizable="true" minw="284" minh="160">
  <group layout="row" gap="6">
    <button text="Add" onclick="{AddRow}" />
    <button text="Remove last" onclick="{RemoveLastRow}" />
    <button text="Shuffle" onclick="{ShuffleRows}" />
  </group>
  <group layout="column" gap="4" scroll="y" grow="1">
    <repeat items="{Rows}" key="{Id}">
      <group layout="row" gap="6" align="center" h="24">
        <checkbox checked="{On}" onchange="{SetOn}" w="20" />
        <label text="{Label}" w="52" />
        <menu items="{Levels}" selected="{Level}" onchange="{SetLevel}" w="70" />
        <number value="{Value}" min="0" max="999" onchange="{SetValue}" grow="1" />
      </group>
    </repeat>
  </group>
  <label text="{Status}" />
</panel>
