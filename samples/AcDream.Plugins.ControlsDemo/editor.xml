<panel x="696" y="48" w="260" h="166" title="Edit profile" theme="plugin">
  <label x="10" y="30" text="Name" />
  <field x="90" y="28" w="160" h="20" maxlength="12" text="{Name}" onchange="{SetName}" />
  <label x="10" y="56" text="Level" />
  <number x="90" y="54" w="70" h="20" value="{Level}" min="1" max="275" onchange="{SetLevel}" />
  <checkbox x="10" y="82" w="200" h="16" text="Use on login" checked="{UseOnLogin}" onchange="{SetUseOnLogin}" />
  <separator x="10" y="120" w="240" h="1" />
  <button x="90" y="132" w="76" h="22" text="Save" onclick="{Save}" />
  <button x="174" y="132" w="76" h="22" text="Cancel" onclick="{Cancel}" />
</panel>
