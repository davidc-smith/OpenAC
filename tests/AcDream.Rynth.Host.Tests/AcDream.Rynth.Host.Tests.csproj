<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- .NET 10 on arm64 (macOS): Tier-0 code throws DataMisalignedException in RynthAi's
         RynthPluginGetSnapshotJson (Interlocked.Exchange on a [ThreadStatic] inside an
         UnmanagedCallersOnly export), so the export returns null. Optimised JIT avoids it. -->
    <TieredCompilationQuickJit>false</TieredCompilationQuickJit>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\AcDream.Rynth.Host\AcDream.Rynth.Host.csproj" />
    <ProjectReference Include="..\..\src\AcDream.Rynth.ScriptWindows\AcDream.Rynth.ScriptWindows.csproj" />
  </ItemGroup>
</Project>
