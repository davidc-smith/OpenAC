<Project Sdk="Microsoft.NET.Sdk">
  <!-- Build step for the Rynth wrappers: copies the data types a RynthCore
       Avalonia panel file declares (and its JSON contexts) out of that file,
       so the ImGui faces that use them compile without Avalonia. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>AcDream.Tools.RynthTypeExtract</RootNamespace>
    <AssemblyName>AcDream.Tools.RynthTypeExtract</AssemblyName>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="AcDream.Tools.RynthTypeExtract.Tests" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
  </ItemGroup>
</Project>
