<Project Sdk="Microsoft.NET.Sdk">
  <!-- Build step for the Rynth wrappers: points a compiled assembly's Win32
       P/Invokes at managed stand-ins, so RynthCore source compiles unchanged. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>AcDream.Tools.RynthInteropRedirect</RootNamespace>
    <AssemblyName>AcDream.Tools.RynthInteropRedirect</AssemblyName>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Mono.Cecil" />
  </ItemGroup>
</Project>
