<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="AcDream.Launcher.Core.Tests" />
    <InternalsVisibleTo Include="AcDream.Launcher.Core.Tests.Fixtures.InstallLeaseHolder" />
    <InternalsVisibleTo Include="acdream-plugincheck" />
  </ItemGroup>
  <ItemGroup>
    <AssemblyMetadata Include="OpenAC.ReleaseRepository" Value="$(OpenACReleaseRepository)" />
    <AssemblyMetadata Include="OpenAC.ReleaseTagPrefix" Value="$(OpenACReleaseTagPrefix)" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\AcDream.Platform\AcDream.Platform.csproj" />
    <ProjectReference Include="..\AcDream.Rynth.NavData\AcDream.Rynth.NavData.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- The navdata pin this launcher was built with: the fallback when a release has no
         rynth-navdata.json beside its manifest. -->
    <EmbeddedResource Include="..\..\external\rynth-navdata.json" LogicalName="OpenAC.RynthNavDataPin.json" />
  </ItemGroup>
</Project>
