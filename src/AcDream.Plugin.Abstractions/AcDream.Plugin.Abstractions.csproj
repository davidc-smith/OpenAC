<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- The plugin contract is documented from its XML comments; an undocumented public member fails the build. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <!-- The contract is the one assembly a plugin references, so it ships as a package: a plugin in
       its own repository builds against a version of the contract instead of against a checkout of
       the client. The version is the repository's own, so the package cannot name a contract this
       build does not provide. Packing is a deliberate, separate step; nothing here publishes. -->
  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <PackageId>AcDream.Plugin.Abstractions</PackageId>
    <Title>OpenAC plugin API</Title>
    <Description>The contract an OpenAC plugin is written against: game state, events, chat, items, automation surfaces and in-game panels. A plugin references this package and nothing else from the client, which is what lets one build run in both the graphical client and the windowless host.</Description>
    <Authors>OpenAC contributors</Authors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageProjectUrl>https://eriknihlen.github.io/OpenAC/</PackageProjectUrl>
    <RepositoryUrl>https://github.com/eriknihlen/OpenAC</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>openac;plugin;asheronscall</PackageTags>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <!-- Fork only (davidc-smith/OpenAC): the fork's contract runs ahead of upstream's under the same
       <Version>, so a plugin in its own repository packs it under a version of its own and never
       mistakes an older 0.1.23 package for it. Bump the fork number whenever the fork changes the
       contract; when a sync moves upstream's <Version>, start again at <Version>-fork.1. Only a pack
       that asks with -p:UseForkContractVersion=true carries it, so the client, restore and the lock
       files keep <Version>. -->
  <PropertyGroup>
    <ForkContractVersion>0.1.23-fork.1</ForkContractVersion>
    <PackageVersion Condition="'$(UseForkContractVersion)' == 'true'">$(ForkContractVersion)</PackageVersion>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>