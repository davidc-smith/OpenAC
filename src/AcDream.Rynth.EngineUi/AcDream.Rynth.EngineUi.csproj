<Project Sdk="Microsoft.NET.Sdk">
  <!-- RynthCore's engine UI faces, compiled unchanged from the submodule against
       our stand-ins for the engine types they use (StandIns/, plus the shared
       ones in AcDream.Rynth.ScriptWindows): the ImGui chat window (ChatFace, the
       filter editor, ChatData and friends) and the RynthAi dashboard (RynthAiFace, its
       drawers, RynthAiData and the settings it edits; its Settings, Items, Damage,
       Monster Detail, Nav, Meta, Loot Editor, Item Count and Lua panels, the Ranges drawer, and their data). One assembly, as in RynthCore: their
       faces share static engine classes (UiSources, PanelRouter, ...).
       RynthCore's Win32Backend, ChatHooks, UiSources, UiDataHub,
       PluginExportBinder and Discord relay are NOT compiled, nor PluginManager,
       EntryPoint, D3D9, ServerInfo, the Avalonia panels, RangesSlideOut or the faces the dashboard
       only links to (see StandIns/DashboardStandIns.cs): the stand-ins of
       those names are plain classes. Their code, their warnings:
       warnings-as-errors and analyzers are off here. -->
  <PropertyGroup>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <RunAnalyzers>false</RunAnalyzers>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <IsPackable>false</IsPackable>
    <RynthEngine>$(MSBuildThisFileDirectory)..\..\external\RynthCore\src\RynthCore.Engine\</RynthEngine>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="$(RynthEngine)UI\Data\Chat*.cs" Link="RynthCore\Data\%(Filename)%(Extension)" />
    <Compile Include="$(RynthEngine)UI\Data\UiSource.cs" Link="RynthCore\Data\UiSource.cs" />
    <Compile Include="$(RynthEngine)UI\Panels\RynthChatPresets.cs" Link="RynthCore\RynthChatPresets.cs" />
    <Compile Include="$(RynthEngine)ImGui\Panels\ChatFace.cs" Link="RynthCore\ChatFace.cs" />
    <Compile Include="$(RynthEngine)ImGui\Panels\ChatFiltersFace.cs" Link="RynthCore\ChatFiltersFace.cs" />
    <Compile Include="$(RynthEngine)ImGui\Panels\FaceKit.cs" Link="RynthCore\FaceKit.cs" />
    <Compile Include="$(RynthEngine)ImGui\Panels\DashboardDrawers.cs" Link="RynthCore\DashboardDrawers.cs" />
    <Compile Include="$(RynthEngine)ImGui\SafeImGui.cs" Link="RynthCore\SafeImGui.cs" />
    <Compile Include="$(RynthEngine)ImGui\RynthTheme.cs" Link="RynthCore\RynthTheme.cs" />
    <Compile Include="$(RynthEngine)ImGui\Panels\RynthAiFace.cs" Link="RynthCore\RynthAiFace.cs" />
    <Compile Include="$(RynthEngine)ImGui\Panels\RynthAiFace.Drawers.cs" Link="RynthCore\RynthAiFace.Drawers.cs" />
    <Compile Include="$(RynthEngine)ImGui\Panels\SettingsRows.cs" Link="RynthCore\SettingsRows.cs" />
    <Compile Include="$(RynthEngine)ImGui\Panels\QuickSettingsDrawer.cs" Link="RynthCore\QuickSettingsDrawer.cs" />
    <Compile Include="$(RynthEngine)ImGui\Panels\SettingsFace.cs" Link="RynthCore\SettingsFace.cs" />
    <Compile Include="$(RynthEngine)ImGui\Panels\ItemsFace.cs" Link="RynthCore\ItemsFace.cs" />
    <Compile Include="$(RynthEngine)ImGui\Panels\DamageFace.cs" Link="RynthCore\DamageFace.cs" />
    <Compile Include="$(RynthEngine)ImGui\Panels\DamageDetailFace.cs" Link="RynthCore\DamageDetailFace.cs" />
    <Compile Include="$(RynthEngine)UI\Data\ItemsData.cs" Link="RynthCore\Data\ItemsData.cs" />
    <Compile Include="$(RynthEngine)UI\Data\DamageData.cs" Link="RynthCore\Data\DamageData.cs" />
    <Compile Include="$(RynthEngine)ImGui\Panels\NavFace.cs" Link="RynthCore\NavFace.cs" />
    <Compile Include="$(RynthEngine)ImGui\Panels\MetaFace.cs" Link="RynthCore\MetaFace.cs" />
    <Compile Include="$(RynthEngine)ImGui\Panels\MetaFace.List.cs" Link="RynthCore\MetaFace.List.cs" />
    <Compile Include="$(RynthEngine)ImGui\Panels\MetaFace.Editor.cs" Link="RynthCore\MetaFace.Editor.cs" />
    <Compile Include="$(RynthEngine)ImGui\Panels\MetaFace.Schedule.cs" Link="RynthCore\MetaFace.Schedule.cs" />
    <Compile Include="$(RynthEngine)UI\Data\MetaData.cs" Link="RynthCore\Data\MetaData.cs" />
    <Compile Include="$(RynthEngine)UI\Data\MetaEditing.cs" Link="RynthCore\Data\MetaEditing.cs" />
    <Compile Include="$(RynthEngine)UI\Data\MetaLocation.cs" Link="RynthCore\Data\MetaLocation.cs" />
    <Compile Include="$(RynthEngine)UI\Data\MetaRowText.cs" Link="RynthCore\Data\MetaRowText.cs" />
    <Compile Include="$(RynthEngine)UI\Data\MetaRuleDto.cs" Link="RynthCore\Data\MetaRuleDto.cs" />
    <Compile Include="$(RynthEngine)UI\Data\MetaStateClock.cs" Link="RynthCore\Data\MetaStateClock.cs" />
    <Compile Include="$(RynthEngine)..\Shared\RynthInstallPaths.cs" Link="RynthCore\RynthInstallPaths.cs" />
    <Compile Include="$(RynthEngine)ImGui\Panels\LootEditorFace.cs" Link="RynthCore\LootEditorFace.cs" />
    <Compile Include="$(RynthEngine)ImGui\Panels\LootAddDialog.cs" Link="RynthCore\LootAddDialog.cs" />
    <Compile Include="$(RynthEngine)UI\Data\LootEditData.cs" Link="RynthCore\Data\LootEditData.cs" />
    <Compile Include="$(RynthEngine)ImGui\Panels\RangesSlideOut.cs" Link="RynthCore\RangesSlideOut.cs" />
    <Compile Include="$(RynthEngine)ImGui\Panels\ItemCountFace.cs" Link="RynthCore\ItemCountFace.cs" />
    <Compile Include="$(RynthEngine)UI\Data\ItemHudModel.cs" Link="RynthCore\Data\ItemHudModel.cs" />
    <Compile Include="$(RynthEngine)UI\Data\ItemHudStore.cs" Link="RynthCore\Data\ItemHudStore.cs" />
    <Compile Include="$(RynthEngine)ImGui\Panels\LuaFace.cs" Link="RynthCore\LuaFace.cs" />
    <Compile Include="$(RynthEngine)UI\Data\LuaData.cs" Link="RynthCore\Data\LuaData.cs" />
    <Compile Include="$(RynthEngine)UI\PanelColumnStore.cs" Link="RynthCore\PanelColumnStore.cs" />
    <Compile Include="$(RynthEngine)UI\Data\RynthAiData.cs" Link="RynthCore\Data\RynthAiData.cs" />
    <Compile Include="$(RynthEngine)UI\Data\SettingsData.cs" Link="RynthCore\Data\SettingsData.cs" />
    <Compile Include="$(RynthEngine)UI\Data\NavData.cs" Link="RynthCore\Data\NavData.cs" />
    <Compile Include="$(RynthEngine)UI\Data\RynthSortData.cs" Link="RynthCore\Data\RynthSortData.cs" />
    <Compile Include="$(RynthEngine)UI\RynthAiDashboardState.cs" Link="RynthCore\RynthAiDashboardState.cs" />
    <Compile Include="$(RynthEngine)UI\PanelTextScale.cs" Link="RynthCore\PanelTextScale.cs" />
    <Compile Include="$(RynthEngine)UI\QuickSettings.cs" Link="RynthCore\QuickSettings.cs" />
    <Compile Include="$(RynthEngine)UI\BarLayout.cs" Link="RynthCore\BarLayout.cs" />
    <Compile Include="$(RynthEngine)Compatibility\TellMemory.cs" Link="RynthCore\TellMemory.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ImGui.NET" />
  </ItemGroup>

  <!-- The Items and Damage faces use data types RynthCore declares inside its
       Avalonia panel files (ItemsPanel.cs, MonstersPanel.cs), and Item Count
       the inventory types beside their acclient-reading InventoryModel. Before
       compile, RynthTypeExtract copies just those types (and the panel files'
       JSON contexts), their text unchanged, into obj/; nothing Avalonia and
       none of InventoryModel's own code is compiled. -->
  <ItemGroup>
    <ProjectReference Include="..\..\tools\RynthTypeExtract\AcDream.Tools.RynthTypeExtract.csproj"
                      ReferenceOutputAssembly="false" Private="false" />
    <RynthPanelTypes Include="$(RynthEngine)UI\Panels\ItemsPanel.cs" Types="ItemsPanel=Payload,WeaponEntry,ConsumableEntry" />
    <RynthPanelTypes Include="$(RynthEngine)UI\Panels\MonstersPanel.cs" Types="MonstersPanel=Payload,CapturedInfo,ItemRef,Rule" />
    <RynthPanelTypes Include="$(RynthEngine)Compatibility\InventoryModel.cs" Types="=InventoryCategory,InventoryItem,InventoryPack,InventoryView" />
  </ItemGroup>

  <Target Name="ExtractRynthPanelTypes" BeforeTargets="CoreCompile">
    <MSBuild Projects="..\..\tools\RynthTypeExtract\AcDream.Tools.RynthTypeExtract.csproj"
             Targets="GetTargetPath"
             Properties="Configuration=$(Configuration)">
      <Output TaskParameter="TargetOutputs" PropertyName="_ExtractTool" />
    </MSBuild>
    <PropertyGroup>
      <_ExtractHost>$(DOTNET_HOST_PATH)</_ExtractHost>
      <_ExtractHost Condition="'$(_ExtractHost)' == ''">dotnet</_ExtractHost>
    </PropertyGroup>
    <MakeDir Directories="$(IntermediateOutputPath)RynthPanelTypes" />
    <Exec Command="&quot;$(_ExtractHost)&quot; &quot;$(_ExtractTool)&quot; &quot;%(RynthPanelTypes.FullPath)&quot; &quot;$(IntermediateOutputPath)RynthPanelTypes/%(RynthPanelTypes.Filename).g.cs&quot; %(RynthPanelTypes.Types)"
          StandardOutputImportance="low" />
    <ItemGroup>
      <Compile Include="$(IntermediateOutputPath)RynthPanelTypes/%(RynthPanelTypes.Filename).g.cs" />
      <FileWrites Include="$(IntermediateOutputPath)RynthPanelTypes/%(RynthPanelTypes.Filename).g.cs" />
    </ItemGroup>
  </Target>

  <ItemGroup>
    <ProjectReference Include="..\AcDream.Rynth.ScriptWindows\AcDream.Rynth.ScriptWindows.csproj" />
  </ItemGroup>

  <!-- Their ChatModel calls the Win32 clipboard through user32/kernel32
       P/Invokes. After compile, the redirect tool points those at the
       Win32ClipboardStandIn of the same names, so copy lines and the filter
       editor's Import/Export use OpenAC's clipboard on every OS. -->
  <ItemGroup>
    <ProjectReference Include="..\..\tools\RynthInteropRedirect\AcDream.Tools.RynthInteropRedirect.csproj"
                      ReferenceOutputAssembly="false" Private="false" />
  </ItemGroup>

  <Target Name="RedirectWin32Clipboard"
          AfterTargets="CoreCompile"
          Inputs="@(IntermediateAssembly)"
          Outputs="$(IntermediateOutputPath)win32-redirect.stamp"
          Condition="'$(DesignTimeBuild)' != 'true'">
    <MSBuild Projects="..\..\tools\RynthInteropRedirect\AcDream.Tools.RynthInteropRedirect.csproj"
             Targets="GetTargetPath"
             Properties="Configuration=$(Configuration)">
      <Output TaskParameter="TargetOutputs" PropertyName="_RedirectTool" />
    </MSBuild>
    <PropertyGroup>
      <_RedirectHost>$(DOTNET_HOST_PATH)</_RedirectHost>
      <_RedirectHost Condition="'$(_RedirectHost)' == ''">dotnet</_RedirectHost>
    </PropertyGroup>
    <WriteLinesToFile File="$(IntermediateOutputPath)win32-redirect.refs" Lines="@(ReferencePath->'%(FullPath)')" Overwrite="true" />
    <Exec Command="&quot;$(_RedirectHost)&quot; &quot;$(_RedirectTool)&quot; &quot;@(IntermediateAssembly->'%(FullPath)')&quot; AcDream.Rynth.EngineUi.Win32ClipboardStandIn &quot;$(IntermediateOutputPath)win32-redirect.refs&quot;" />
    <Touch Files="$(IntermediateOutputPath)win32-redirect.stamp" AlwaysCreate="true" />
  </Target>

  <ItemGroup>
    <InternalsVisibleTo Include="AcDream.Rynth.Host" />
    <InternalsVisibleTo Include="AcDream.Rynth.Host.Tests" />
    <InternalsVisibleTo Include="AcDream.App.Tests" />
  </ItemGroup>
</Project>
