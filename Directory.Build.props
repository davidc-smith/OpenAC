<Project>
  <PropertyGroup>
    <!-- Repository-wide language and warning policy. Project files only override
         these values when a target has a documented, target-specific need. -->
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AnalysisLevel>latest</AnalysisLevel>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
    <!-- Upstream's version, unchanged between upstream syncs: lock files record it.
         Our release version is OpenACReleaseVersion below (see BRANCHING.md). -->
    <Version>0.1.26</Version>
    <OpenACProduct>OpenAC Gateway</OpenACProduct>
    <OpenACReleaseLabel>gateway</OpenACReleaseLabel>
    <OpenACReleaseNumber>1</OpenACReleaseNumber>
    <!-- The GitHub repository whose releases are the launcher's update feed and the
         publish script's asset addresses: the fork's own until it merges back upstream. -->
    <OpenACReleaseRepository>davidc-smith/OpenAC</OpenACReleaseRepository>

    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <NuGetLockFilePath Condition="'$(RuntimeIdentifier)' == ''">$(MSBuildProjectDirectory)/packages.neutral.lock.json</NuGetLockFilePath>
    <NuGetLockFilePath Condition="'$(RuntimeIdentifier)' != ''">$(MSBuildProjectDirectory)/packages.$(RuntimeIdentifier).lock.json</NuGetLockFilePath>
  </PropertyGroup>

  <!-- A product line's own identity (the rynth branch's Gateway Rynth); main has no such file. -->
  <Import Project="$(MSBuildThisFileDirectory)Directory.Branch.props"
          Condition="Exists('$(MSBuildThisFileDirectory)Directory.Branch.props')" />

  <PropertyGroup>
    <OpenACReleaseVersion>$(Version)-$(OpenACReleaseLabel).$(OpenACReleaseNumber)</OpenACReleaseVersion>
    <InformationalVersion>$(OpenACReleaseVersion)$(OpenACReleaseMetadata)</InformationalVersion>
    <Product>$(OpenACProduct)</Product>
  </PropertyGroup>

  <!-- XML documentation files of our own assemblies feed the IDE and the plugin
       SDK; they are never runtime assets, so no publish payload carries them
       (the macOS bundle signer rejects an unsigned non-code file in the
       executable folder). -->
  <Target Name="ExcludeOwnDocumentationFilesFromPublish" AfterTargets="ComputeResolvedFilesToPublishList" Condition="'$(PublishOwnDocumentationFiles)' != 'true'">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)"
                             Condition="'%(Extension)' == '.xml' and $([System.String]::new('%(Filename)').StartsWith('AcDream.'))" />
    </ItemGroup>
  </Target>
</Project>
